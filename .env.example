# Ternion: environment variables for Vercel
# Vercel > Project > Settings > Environment Variables > "Import .env" (or paste each line).
# Keep this file private: it is git-ignored and excluded from Vercel uploads.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=ternion.vercel.app,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://ternion.vercel.app

# Postgres connection string for the quote form (Vercel Postgres / Neon / Supabase).
# Example: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=
